{
  "name": "alapa-project",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "tsc": "rimraf -rf dist && tsc",
    "webpack": "tsc  --project tsconfig.public.json && webpack",
    "build:css": "npx postcss public/styles/tailwind.css -o static/css/app.css",
    "dev:start": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf -rf dist",
    "generate-docs": "node docs/generate.js",
    "migration:generate": "node migration-runner/generate.js",
    "migration:run": "node migration-runner/run.js",
    "migration:revert": "node migration:revert -d dist/config/database.js",
    "build": "npm run build:css && npm run webpack && npm run tsc",
    "lint": "eslint src/**/*.ts",
    "dev:server": "node ./dev/index.js",
    "watch:refresh": "node ./dev/watch-refresh.js",
    "watch:app": "nodemon  --signal SIGKILL --watch src --watch docs  --ext \"*\"  --delay 0.5 --exec npm run dev:start",
    "dev": "npm-run-all --parallel webpack dev:server watch:app watch:refresh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@types/express": "^5.0.3",
    "@types/toastr": "^2.1.43",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "chokidar": "^4.0.3",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.41",
    "postcss-cli": "^11.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.83.1",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "ioredis": "^5.8.2",
    "kafkajs": "^2.2.4",
    "module-alias": "^2.2.3",
    "sqlite3": "^5.1.7",
    "toastr": "^2.1.4"
  },
  "_moduleAliases": {
    "@models": "src/models",
    "@api": "src/api",
    "@app": "src/app",
    "@middleware": "src/middleware",
    "@service": "src/service",
    "@shared": "src/shared"
  }
}
